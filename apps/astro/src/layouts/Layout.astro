---
import Sidebar from '@/components/Sidebar.astro'
import Footer from '@/components/Footer.astro'
import { ClientRouter } from 'astro:transitions'

import type { General, PageSlug } from '@monolithe/api/types'

const analytics = {
  enable: process.env.ANALYTICS_ENABLE === 'true',
  id: process.env.ANALYTICS_ID,
  domain: process.env.ANALYTICS_Domain,
}

type Props = {
  footer: General.Footer
  navigation: General.Navigation
  meta: {
    title: string
  }
  slug: PageSlug
  parentSlug?: PageSlug
}

const { footer, navigation, meta, slug, parentSlug } = Astro.props

const { home, menu } = navigation

const { logoCatch, contact, services } = footer

const sidebarType = slug === 'pageHome' ? 'big' : 'small'

const bodyModifiers = [`sidebar-${slug === 'pageHome' ? 'big' : 'small'}`]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Monolithe – Gravure • Art funéraire – {meta.title}</title>
    <meta
      name="description"
      content="Leila Danerol – Artisane graveuse sur Bren, Drôme – Création, restauration, gravure de monuments funéraires"
    />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <meta name="theme-color" content="#1e1e1e" />

    {
      analytics.enable && (
        <script defer src={`${analytics.domain}/script.js`} data-website-id={analytics.id} />
      )
    }

    <ClientRouter />
  </head>

  <body data-theme="light" class:list={['body', ...bodyModifiers.map((a) => `body--${a}`)]}>
    <div class="container">
      <div class="container__inner">
        <div class="content">
          <main class="main">
            <slot />
          </main>

          <Footer logoCatch={logoCatch} contact={contact} services={services} />

          <Sidebar home={home} menu={menu} type={sidebarType} slug={slug} parentSlug={parentSlug} />
        </div>
      </div>
    </div>
  </body>
</html>

<style lang="scss">
  html,
  body {
    background-color: var(--color-gray-100);
    color: var(--color-gray-00);
    font-family: var(--font-family-body);
    height: 100%;
    font-size: var(--font-size-s);
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    position: relative;
  }

  .container {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: center;
    overflow-x: clip;
    font-size: var(--font-size-m);

    &__inner {
      max-width: var(--width-container-max);
      width: 100%;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .main {
    flex-grow: 1;
  }
</style>
