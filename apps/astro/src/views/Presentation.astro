---
import HeroView from '@/components/Hero.astro'
import Logo from '@/assets/svgs/logo.svg'
import Separator from '@/components/Separator.astro'

import type { Hero } from '@monolithe/api/types'

type Props = {
  hero: Hero
  presentation?: string
}

const { hero, presentation } = Astro.props
---

<div class="page">
  <HeroView {...hero} />

  <div class="content">
    <section class="presentation">
      <div class="presentation__left">
        <Logo class:list={'presentation__logo'} />
      </div>
      <p class="presentation__right">{presentation}</p>
    </section>

    <Separator />
  </div>
</div>

<style lang="scss">
  @use '../styles/utilities/' as *;

  .content {
    @include content-padding;
  }

  section {
    @include grid;
    padding: var(--space-128) 0;
  }

  .presentation {
    &__left {
      grid-column: span 4;
    }

    &__right {
      grid-column: 5 / span 8;
    }

    &__logo {
      color: var(--color-gold-40);
      width: pxToRem(180px);
    }
  }
</style>
