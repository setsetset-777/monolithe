---
import HeroView from '@/components/HeroPlant.astro'
import Logo from '@/assets/svgs/logo.svg'
import Separator from '@/components/Separator.astro'
import Form from '@/components/Form.astro'
import { ZodError } from 'astro:schema'
import { hit } from '@/lib/rateLimit'
import { honeyName, type Data } from '@/lib/mail'
import { mail, schema, errorMessages, formatMailHtml, formatMailText } from '@/lib/mail'

import type { Contact, Hero } from '@monolithe/api/types'

type Props = {
  hero: Hero
  info: Contact.Info
  form: Contact.Form
}

const {
  hero,
  info: { logoCatch, name, place, email, phone },
  form,
} = Astro.props

let errorMessage, success, data

let errors: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  if (!hit(`ip:${Astro.clientAddress}`, 3, 10 * 60_000) || !hit('global', 50, 60 * 60_000)) {
    return new Response('Too many requests', { status: 429 })
  }

  try {
    const formData = await Astro.request.formData()

    const honey = formData.get(honeyName)

    if (!(honey === null || honey === '' || typeof honey === 'undefined')) {
      throw new Error(errorMessages.general)
    }

    data = Object.fromEntries(formData)
    data = schema.parse(data)

    const params = {
      from: data.email,
      subject: 'Monolithe – Formulaire  de contact',
      to: form.email,
      html: formatMailHtml(data),
      text: formatMailText(data),
    }

    await mail(params)

    success = true
  } catch (error) {
    if (error instanceof ZodError) {
      errorMessage = errorMessages.check
      errors = error.flatten((issue) => issue.message).fieldErrors
    } else if (error instanceof Error) {
      console.error(error.message)
      errorMessage = errorMessages.general
    }
  }
}
---

<div class="page">
  <HeroView {...hero} />
  <div class="content">
    <section class="info">
      <div class="info__company">
        <div class="logo">
          <Logo />
        </div>
        {logoCatch && <p class="logo-catch">{logoCatch}</p>}
      </div>
      <div class="info__contact">
        {place && <p class="name">{name}</p>}
        {place && <p class="place">{place}</p>}
        {email && (
          <button data-email={btoa(email)} type="button" class="email link">
            &nbsp;
          </button>
        )}
        {phone && (
          <button data-tel={btoa(phone)} type="button" class="phone link">
            &nbsp;
          </button>
        )}
      </div>
    </section>
    <Separator />
    <section class="form">
      <Form
        {...form}
        success={success}
        errorMessage={errorMessage}
        data={data as Data}
        errors={errors}
      />
    </section>
  </div>
</div>

<script>
  const initLinks = (links: NodeListOf<HTMLButtonElement>) => {
    Array.from(links).forEach((el) => {
      const type = el.dataset.tel ? 'tel' : 'email'
      const redirect = type === 'tel' ? 'tel' : 'mailto'
      const hash = el.dataset[type]
      if (!hash) return
      const value = atob(hash)
      el.innerText = value
      el.addEventListener('click', (e) => {
        e.preventDefault()
        window.location.href = `${redirect}:${value}`
      })
    })
  }
  document.addEventListener('astro:page-load', () => {
    const links = document.querySelectorAll<HTMLButtonElement>('[data-email], [data-tel]')
    initLinks(links)
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .content {
    @include content-padding;
    padding-top: var(--content-padding-y);
    padding-bottom: var(--content-padding-y);
    display: flex;
    flex-direction: column;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    padding-top: var(--section-padding-y);
    padding-bottom: var(--section-padding-y);

    &__company {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    &__contact {
      display: flex;
      flex-direction: column;
      justify-content: end;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .logo {
    color: var(--color-gold-30);
    width: pxToRem(90px);
  }

  .name {
    color: var(--color-gold-30);
    font-weight: bold;
  }

  .place {
  }

  .email,
  .phone {
  }

  .form {
    padding-top: var(--section-padding-y);
    padding-bottom: var(--section-padding-y);
  }

  @include from(mobile) {
    .info {
      @include grid;

      &__company {
        grid-column: span 6;
      }

      &__contact {
        grid-column: span 6;
      }
    }
  }

  @include from(big-mobile) {
    .info {
      &__company {
        grid-column: span 4;
      }

      &__contact {
        grid-column: span 8;
      }
    }
  }
</style>
