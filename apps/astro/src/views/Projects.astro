---
import HeroView from '@/components/Hero.astro'
import ProjectList from '@/components/projects/ProjectList.astro'

import type { Projects } from '@monolithe/api/types'

type Props = Projects.Data

const { hero, services, projects } = Astro.props
---

<div class="page">
  <HeroView {...hero} />
  <fieldset class="services" data-services>
    <ul>
      {
        services.map(({ label, slug }) => (
          <li>
            <input type="checkbox" id={slug} name="projects-service" value={slug} />
            <label for={slug}>{label}</label>
          </li>
        ))
      }
    </ul>
  </fieldset>
  <div class="projects" id="projects">
    <ProjectList projects={projects} />
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client'

  const seperator = ','

  const initServicesChecked = () => {
    const url = new URL(window.location.href)
    const services = url.searchParams.get('services')?.toString().split(seperator)

    Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="projects-service"]'),
    ).forEach((input) => {
      input.checked = !!services?.includes(input.value)
    })
  }

  const initServicesChange = () => {
    document.querySelector('.services')?.addEventListener('change', async (e) => {
      if (!(e.currentTarget instanceof HTMLElement)) return

      const sectionsContainer = document.querySelector('#projects')

      if (!sectionsContainer) return

      const activeServices = Array.from(
        e.currentTarget.querySelectorAll<HTMLInputElement>(
          'input[name="projects-service"]:checked',
        ),
      ).map((item) => item.value)
      const params = new URLSearchParams()
      if (activeServices.length > 0) {
        params.set('services', activeServices.join(seperator))
      } else {
        params.delete('services')
      }

      const response = await fetch(`/q/projects?${params.toString()}`)

      if (!response.ok) {
        throw new Error('Failed to load projects')
      }

      sectionsContainer.innerHTML = await response.text()

      const url = new URL(window.location.href)
      if (activeServices.length > 0) {
        url.searchParams.set('services', activeServices.join(seperator))
      } else {
        url.searchParams.delete('services')
      }

      window.history.pushState(
        {
          url: url.toString(),
        },
        '',
        url.toString(),
      )
    })
  }
  document.addEventListener('astro:page-load', () => {
    initServicesChecked()
    initServicesChange()
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .page {
    @include content-padding;
  }
</style>
