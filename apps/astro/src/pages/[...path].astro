---
import '../styles/index.scss'

import { getPage, getGeneral } from '@/lib/page'
import Layout from '@/layouts/Layout.astro'
import Home from '../views/Home.astro'
import Presentation from '../views/Presentation.astro'
import Services from '../views/Services.astro'
import Projects from '../views/Projects.astro'
import Project from '../views/Project.astro'
import Contact from '../views/Contact.astro'
import type { Meta, General } from '@monolithe/api/types'

export async function getStaticPaths() {
  const data = await getGeneral()
  console.log('data', data)
  const { routes, navigation, footer } = data

  const paths = Object.values(routes).map((route) => ({
    params: { path: route.path },
    props: {
      meta: route.meta,
      navigation,
      footer,
      path: route.path,
    },
  }))

  return paths
}

type Props = {
  meta: Meta
  navigation: General.Navigation
  footer: General.Footer
  path: string
}

const { meta, navigation, footer, path } = Astro.props

const { slug, data } = await getPage(path)

if (!slug) {
  return Astro.redirect('/404')
}
---

<Layout navigation={navigation} footer={footer} meta={{ title: meta.title }} slug={slug}>
  {slug === 'pageHome' && <Home {...data} />}
  {slug === 'pagePresentation' && <Presentation {...data} />}
  {slug === 'pageServices' && <Services {...data} />}
  {slug === 'pageProjects' && <Projects {...data} />}
  {slug === 'projects' && <Project {...data} />}
  {slug === 'pageContact' && <Contact {...data} />}
</Layout>

<style lang="scss">
  html,
  body {
    background-color: var(--color-gray-100);
    color: var(--color-gray-00);
    font-family: var(--font-family-body);
    height: 100%;
    font-size: var(--font-size-s);
    scroll-behavior: smooth;
  }
</style>
