---
import api from '@monolithe/api'
import ProjectList from '@/components/projects/ProjectList.astro'

const params = new URLSearchParams(Astro.url.search)

const services = params.get('services') ?? undefined
const page = params.get('page') ?? undefined
const limit = params.get('limit') ?? undefined

const projects = await api.projects({ services, page, limit })

export const partial = true
---

<ProjectList projects={projects} />
