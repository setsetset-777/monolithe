---
import type { Presentation } from '@monolithe/api/types'

type Props = Presentation.TestimonialsSection

const { title, list } = Astro.props
---

<section>
  <h3 class="title">{title}</h3>
  <div class="list">
    {
      list.map(({ description, name, company }) => (
        <div class="testimonial">
          <div class="testimonial__description">
            <p>{description}</p>
          </div>
          <div class="testimonial__info">
            <span class="testimonial__name">{name}</span>
            <span class="testimonial__company">{company}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use '../../styles/utilities' as *;

  section {
    display: flex;
    flex-direction: column;
    padding: var(--section-padding-y) 0;
    gap: var(--space-48);
  }

  .title {
    @include font-heading-2;
    color: var(--color-font-gold);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);

    &__description {
      @include font-heading-3;
      position: relative;

      p {
        position: relative;
        z-index: 2;
      }

      &:before,
      &:after {
        display: block;
        position: absolute;
        color: var(--color-gold-50);
        font-size: 8rem;
        z-index: 1;
      }

      &:before {
        content: '“';
        top: -2rem;
        left: -2rem;
      }

      &:after {
        content: '”';
        right: -1rem;
        bottom: -6rem;
      }
    }

    &__info {
      display: flex;
      gap: var(--space-8);
      flex-wrap: wrap;
    }

    &__name {
      color: var(--color-gold-40);
      @include ellipsis;
    }

    &__company {
      color: var(--color-gray-10);
      @include ellipsis;
    }
  }

  @include from(mobile) {
    .list {
      @include grid;
      row-gap: var(--space-64);
    }

    .testimonial {
      grid-column: span 6;
    }
  }

  @include from(desktop) {
    .testimonial {
      grid-column: span 4;
    }
  }
</style>
