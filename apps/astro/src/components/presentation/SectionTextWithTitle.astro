---
import Image from '@/components/Image.astro'
import type { Presentation } from '@monolithe/api/types'

type Props = Presentation.TextWithTitleSection

const { title, text, image } = Astro.props
---

<section>
  <h3 class="title">{title}</h3>
  <div class="image">
    <div class="image__inner">
      {
        image && (
          <Image
            src={image.url}
            alt={image.alt}
            srcset={{
              '800w': image.sizes?.[2000]?.url!,
              '1200w': image.sizes?.[3000]?.url!,
            }}
            modifiers={['fill']}
          />
        )
      }
    </div>
  </div>
  <div class="text p-space" set:html={text} />
</section>

<style lang="scss">
  @use '../../styles/utilities' as *;

  section {
    display: flex;
    flex-direction: column;
    padding: var(--section-padding-x) 0;
    row-gap: var(--space-48);
  }

  .title {
    @include font-heading-2;
    color: var(--color-font-gold);
  }

  .image {
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-1);
    position: relative;
  }

  @include from(mobile) {
    section {
      @include grid;
    }

    .title {
      grid-column: 6 / span 7;
      order: 2;
    }

    .image {
      grid-column: span 5;
      grid-row: span 2;
      order: 1;

      &__inner {
        position: absolute;
        height: 100%;
        width: 100%;
      }
    }

    .text {
      order: 3;
      grid-column: 6 / span 7;
    }
  }
</style>
