---
import type { Presentation } from '@monolithe/api/types'

type Props = Presentation.ListSection

const { title, values } = Astro.props
---

<section>
  <div class="title">
    <h3>{title}</h3>
  </div>
  <div class="list">
    <ul>
      {
        values.map(({ title }) => (
          <li>
            <span>{title}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use '../../styles/utilities/' as *;

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    padding: var(--section-padding-y) 0;
  }

  .title {
    @include font-heading-2;
    color: var(--color-font-gold);
    grid-column: span 3;
  }

  .list {
    --column-gap: var(--grid-gap);

    ul {
      display: flex;
      flex-direction: row;
      row-gap: var(--space-16);
      flex-wrap: wrap;
      column-gap: var(--column-gap);
    }

    li {
      @include font-heading-3;
      display: flex;
      gap: var(--space-16);
      align-items: center;
      width: 100%;
      flex-basis: 100%;

      span {
        display: block;
        width: 100%;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
      }

      &:before {
        $size: pxToRem(6px);
        content: '';
        display: block;
        width: $size;
        height: $size;
        background-color: var(--color-gold-30);
        transform: rotate(45deg);
        flex-shrink: 0;
      }
    }
  }

  @include from(mobile) {
    .list {
      li {
        flex-basis: calc(50% - var(--column-gap) / 2);
      }
    }
  }

  @include from(desktop) {
    section {
      @include grid;
    }

    .list {
      grid-column: 4 / span 8;
    }
  }
</style>
