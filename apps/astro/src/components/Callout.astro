---
import ErrorSvg from '@/assets/svgs/error.svg'
import SuccessSvg from '@/assets/svgs/success.svg'
interface Props {
  type: 'success' | 'error' | null
  hidden: boolean
}

const { type, hidden } = Astro.props
---

<div class="callout" data-status data-type={type} hidden={hidden || type === null}>
  <span class="callout__icon callout__icon--error">
    <ErrorSvg />
  </span>
  <span class="callout__icon callout__icon--success">
    <SuccessSvg />
  </span>
  <div data-status-content>
    <slot />
  </div>
</div>

<style lang="scss">
  .callout {
    $callout: &;

    background-color: var(--color-gray-50);
    border-radius: var(--radius-2);
    padding: var(--space-24);
    display: flex;
    gap: var(--space-16);

    &[hidden] {
      display: none;
    }

    &__icon {
      display: none;

      #{$callout}[data-type='error'] &--error {
        color: var(--color-red-30);
        display: block;
      }

      #{$callout}[data-type='success'] &--success {
        color: var(--color-gold-30);
        display: block;
      }
    }
  }
</style>
