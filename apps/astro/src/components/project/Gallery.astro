---
import Image from '@/components/Image.astro'
import type { Project } from '@monolithe/api/types'

interface Props {
  images: Project.Gallery
}

const { images } = Astro.props
const gallery: Array<Project.GalleryItem[]> = []

images.forEach((image) => {
  // Full images get new row
  if (image.fullwidth) {
    gallery.push([image])
    return
  }

  const lastRow = gallery.at(-1)

  // Start a new row if there is no row,
  // or the previous row already contains 2 images,
  // or the previous row contains a full-width image.
  if (!lastRow || lastRow.length >= 2 || lastRow[0].fullwidth) {
    gallery.push([image])
  } else {
    lastRow.push(image)
  }
})
---

<div class="gallery">
  {
    gallery.map((images) => {
      return (
        <div class="row">
          {images.map(
            ({ fullwidth, image, text }) =>
              image && (
                <div
                  class:list={['image', fullwidth && 'image--full']}
                  style={
                    images.length > 1 && image.width && image.height
                      ? `--aspect-ratio: ${image.width / image.height}`
                      : undefined
                  }
                >
                  {fullwidth ? (
                    <Fragment>
                      <Image
                        src={image.url}
                        alt={image.alt}
                        srcset={{
                          '800w': image.sizes?.[1000]?.url!,
                          '1600w': image.sizes?.[2000]?.url!,
                        }}
                        modifiers={['fill']}
                      />
                      {text && <p class="text">{text}</p>}
                    </Fragment>
                  ) : (
                    <Image
                      src={image.url}
                      alt={image.alt}
                      srcset={{
                        '400w': image.sizes?.[500]?.url!,
                        '800w': image.sizes?.[1000]?.url!,
                      }}
                      modifiers={['fill']}
                    />
                  )}
                </div>
              ),
          )}
        </div>
      )
    })
  }
</div>

<style lang="scss">
  @use '../../styles/utilities' as *;

  .gallery {
    --row-gap: var(--space-48);
    --column-gap: var(--space-48);

    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
    padding-top: var(--section-padding-y);
    padding-bottom: var(--section-padding-y);
  }

  .image {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);

    &:not(&--full) {
      flex: var(--aspect-ratio) 1 0;
    }
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }

  .text {
    font-size: var(--font-size-s);
    color: var(--color-gray-20);
  }

  @include from(mobile) {
    .gallery {
      --row-gap: var(--space-64);
    }

    .row {
      flex-direction: row;
      gap: var(--column-gap);
    }
  }
</style>
