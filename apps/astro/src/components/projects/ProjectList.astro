---
import type { Projects } from '@monolithe/api/types'

interface Props {
  projects: Projects.Data['projects']
}

const { projects } = Astro.props

const isEmpty = projects.docs.length <= 0
---

<Fragment>
  {
    isEmpty ? (
      <div class="empty">Aucun projets trouvés</div>
    ) : (
      projects.docs.map(({ title }) => {
        return <article>{title}</article>
      })
    )
  }
</Fragment>
