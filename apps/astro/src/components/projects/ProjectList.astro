---
import ProjectListItem from './ProjectListItem.astro'
import type { Projects } from '@monolithe/api/types'

interface Props {
  projects: Projects.List['docs']
}

const { projects } = Astro.props
---

<Fragment>
  {
    projects.map((project) => {
      return <ProjectListItem {...project} />
    })
  }
</Fragment>
