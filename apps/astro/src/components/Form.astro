---
import Field from '@/components/Field.astro'
import Action from '@/components/Action.astro'
import HoneyPot from '@/components/HoneyPot.astro'
import Callout from '@/components/Callout.astro'
import type { Contact } from '@monolithe/api/types'
import type { Data } from '@/lib/mail'

type Props = Contact.Form & {
  errorMessage?: string
  success?: boolean
  data: Data
  errors: Record<string, string>
}

const {
  title,
  introduction,
  successMessage,
  actionLabel,
  slug,
  email: to,
  errorMessage,
  success,
  data,
  errors,
} = Astro.props
---

<form class="form" id={slug} method="post" novalidate action={`#${slug}`}>
  <h2 class="form__title">{title}</h2>
  {introduction && <p class="form__intro">{introduction}</p>}
  {errorMessage && <Callout type="error">{errorMessage}</Callout>}
  {success ? (
    <Callout type="success">{successMessage}</Callout>
  ) : (
    <div class="form__fields">
      <Field
        label="Nom"
        required={true}
        name="name"
        type="text"
        placeholder="Jeane Dupont"
        value={data?.name ? (data?.name as string) : null}
        error={errors.name}
      />

      <Field
        label="Email"
        required={true}
        name="email"
        type="email"
        placeholder="jeanne.dupont@mail.fr"
        value={data?.email ? (data?.email as string) : null}
        error={errors.email}
      />

      <Field
        label="Téléphone"
        required={false}
        name="phone"
        type="tel"
        placeholder="0612345678"
        value={data?.phone ? (data?.phone as string) : null}
        error={errors.phone}
      />

      <Field
        label="Message"
        required={true}
        name="message"
        type="textarea"
        value={data?.message ? (data?.message as string) : null}
        placeholder="Demande de renseignement, de devis..."
        error={errors.message}
      />

      <HoneyPot />

      <div class="form__footer">
        <Action type="submit">{actionLabel}</Action>
      </div>
    </div>
  )}
</form>

<style lang="scss">
  @use '../styles/utilities' as *;

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    max-width: pxToRem(600px);

    &__title {
      font-family: var(--font-family-heading);
      font-size: var(--font-size-xl);
    }

    &__fields {
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
      align-items: stretch;
    }

    &__footer {
      display: flex;
      justify-content: flex-end;
    }
  }
</style>
