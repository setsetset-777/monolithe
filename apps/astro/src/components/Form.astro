---
import Field from '@/components/Field.astro'
import Action from '@/components/Action.astro'
import HoneyPot from '@/components/HoneyPot.astro'
import Callout from '@/components/Callout.astro'
import { honeyName } from '@/lib/mail'
import { mail } from '@/lib/mail'
import type { Contact } from '@monolithe/api/types'
import * as z from 'zod'
import { ZodError } from 'astro:schema'
import { hit } from '@/lib/rateLimit'

type Props = Contact.Form

const { title, introduction, successMessage, actionLabel, slug, email: to } = Astro.props

let errorMessage, success

const errorMessages = {
  required: 'Ce champ est obligatoire.',
  email: 'Cet email est invalide.',
  check: 'Vérifiez vos informations.',
  general: "Une erreur est survenue. Merci d'essayer plus tard.",
  tooLong: 'Le champs entré est trop long',
}

let data

const schema = z.object({
  name: z.string().min(1, errorMessages.required).max(100, errorMessages.tooLong),
  email: z.email(errorMessages.email).max(200, errorMessages.tooLong),
  phone: z.string().max(20, errorMessages.tooLong).optional(),
  message: z.string().min(1, errorMessages.required).max(10000, errorMessages.tooLong),
})

let errors: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  if (!hit(`ip:${Astro.clientAddress}`, 3, 10 * 60_000) || !hit('global', 50, 60 * 60_000)) {
    return new Response('Too many requests', { status: 429 })
  }

  try {
    const formData = await Astro.request.formData()

    const honey = formData.get(honeyName)

    if (!(honey === null || honey === '' || typeof honey === 'undefined')) {
      throw new Error(errorMessages.general)
    }

    data = Object.fromEntries(formData)
    data = schema.parse(data)

    const from = data.email
    const subject = 'Monolithe – Formulaire  de contact'
    const phoneBlock = data.phone
      ? `<p>
      <b>Téléphone :</b> ${data.phone}
      </p>`
      : ''
    const html = `<p>Chère Monolithe,</p>
      <p>Quelqu'un vous a contacté via le formulaire de votre site. Vous pouvez envoyer un message directement en répondant à cet email.</p>

      <p>
      <b>Nom :</b> ${data.name}
      </p>

      <p>
      <b>Email :</b> ${data.email}
      </p>

      ${phoneBlock}
<p>
<b>Message : </b>
<br /><br />
${data.message}
</p>
`

    const params = {
      from,
      subject,
      to,
      html,
    }

    await mail(params)

    success = true
  } catch (error) {
    if (error instanceof ZodError) {
      errorMessage = errorMessages.check
      errors = error.flatten((issue) => issue.message).fieldErrors
    } else if (error instanceof Error) {
      console.error(error.message)
      errorMessage = errorMessages.general
    }
  }
}
---

<form class="form" id={slug} method="post" novalidate action={`#${slug}`}>
  <h2 class="form__title">{title}</h2>
  {introduction && <p class="form__intro">{introduction}</p>}
  {errorMessage && <Callout type="error">{errorMessage}</Callout>}
  {success ? (
    <Callout type="success">{successMessage}</Callout>
  ) : (
    <div class="form__fields">
      <Field
        label="Nom"
        required={true}
        name="name"
        type="text"
        placeholder="Jeane Dupont"
        value={data?.name ? (data?.name as string) : null}
        error={errors.name}
      />

      <Field
        label="Email"
        required={true}
        name="email"
        type="email"
        placeholder="jeanne.dupont@mail.fr"
        value={data?.email ? (data?.email as string) : null}
        error={errors.email}
      />

      <Field
        label="Téléphone"
        required={false}
        name="phone"
        type="tel"
        placeholder="0612345678"
        value={data?.phone ? (data?.phone as string) : null}
        error={errors.phone}
      />

      <Field
        label="Message"
        required={true}
        name="message"
        type="textarea"
        value={data?.message ? (data?.message as string) : null}
        placeholder="Demande de renseignement, de devis..."
        error={errors.message}
      />

      <HoneyPot />

      <div class="form__footer">
        <Action type="submit">{actionLabel}</Action>
      </div>
    </div>
  )}
</form>

<style lang="scss">
  @use '../styles/utilities' as *;

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    max-width: pxToRem(600px);

    &__title {
      font-family: var(--font-family-heading);
      font-size: var(--font-size-xl);
    }

    &__fields {
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
      align-items: stretch;
    }

    &__footer {
      display: flex;
      justify-content: flex-end;
    }
  }
</style>
