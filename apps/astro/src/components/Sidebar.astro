---
import Logo from '@/assets/svgs/logo.svg'
import Separator from '@/components/Separator.astro'
import SidebarSwitch from '@/components/SidebarSwitch.astro'

import { getHerbier } from '@/lib/herbiers'
import type { PageSlug } from '@monolithe/api/types'

type Props = {
  home: {
    url: string
    linkLabel: string
  }
  menu: {
    title: string
    url: string
    slug: PageSlug
  }[]
  type?: 'big' | 'small'
  slug: PageSlug
  parentSlug?: PageSlug
}

const { home, menu, type = 'big', slug, parentSlug } = Astro.props

const herbierLeft = getHerbier('left')
const herbierCentre = getHerbier('centre')
---

<aside
  class:list={['sidebar', `sidebar--${type}`]}
  data-sidebar={type}
  transition:animate="none"
  transition:persist="sidebar"
  data-open="false"
  data-direction="north"
>
  <div class="container">
    <div class="content">
      <div class="header">
        <a href={home.url} aria-label={home.linkLabel}>
          <Logo class:list={'logo'} />
        </a>
        <SidebarSwitch />
      </div>
      <div class="main">
        <div class="main__inner">
          <Separator />
          <nav class="menu">
            <ul class="menu__list" data-menu>
              {
                menu.map(({ title, url, slug: itemSlug }) => (
                  <li class="menu__item">
                    <a
                      class:list={[
                        'menu__link',
                        (slug === itemSlug || parentSlug === itemSlug) && 'active',
                      ]}
                      href={url}
                      data-menu-item
                      data-slug={itemSlug}
                    >
                      {title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <Separator />
        </div>
      </div>
    </div>
    <div class="plants plants--left" data-plants>
      {
        herbierLeft.map(({ slug, plant }) => {
          const Plant = plant
          return (
            <div class="plants__item" data-slug={slug}>
              <Plant class:list={'plants__svg'} />
            </div>
          )
        })
      }
    </div>
    <div class="plants plants--centre" data-plants>
      {
        herbierCentre.map(({ slug, plant }) => {
          const Plant = plant
          return (
            <div class="plants__item" data-slug={slug}>
              <Plant class:list={'plants__svg'} />
            </div>
          )
        })
      }
    </div>
  </div>
</aside>

<script>
  import Sidebar from '@/lib/Sidebar'

  const sidebar = new Sidebar()

  sidebar.initOnce()

  document.addEventListener('astro:page-load', () => {
    sidebar.initOnLoad()
  })

  document.addEventListener('astro:after-preparation', () => {
    sidebar.close()
  })
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .sidebar {
    --menu-gap: var(--space-4);
    --content-gap: clamp(var(--space-16), 6dvh, var(--space-48));
    --logo-height: var(--sidebar-logo-height);
    --container-padding-y: var(--content-padding-y);
    view-transition-name: none;

    height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    position: fixed;
    z-index: 2;
    color: var(--color-gray-100);

    &:after {
      content: '';
      display: block;
      width: var(--sidebar-skew-size);
      background: var(--color-gold-40);
      clip-path: polygon(0 0, 100% 0, calc(100% - var(--sidebar-skew-size)) 100%, 0 100%);
      flex-shrink: 0;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 100%;
      z-index: 1;
    }
  }

  .container {
    background: var(--color-gold-40);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    padding: var(--container-padding-y) 0 var(--container-padding-y) var(--content-padding-x);
    justify-content: space-between;
    width: var(--sidebar-width);
    @include transition(width);

    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      right: 100%;
      bottom: 0;
      width: 100vw;
      background: var(--color-gold-40);
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--content-gap);
  }

  .main {
    &__inner {
      display: flex;
      flex-direction: column;
      gap: var(--content-gap);
    }
  }

  .logo {
    height: var(--logo-height);
    @include transition(height, medium);
  }

  .switch {
    display: none;
  }

  .menu {
    font-family: var(--font-family-heading);

    &__list {
      display: flex;
      flex-direction: column;
      gap: var(--menu-gap);
      @include transition(gap);
    }

    &__link {
      font-family: var(--font-family-heading);
      font-size: var(--sidebar-menu-fontsize);
      text-decoration: none;
      @include transition('color, font-size');

      &:hover,
      &.active {
        color: var(--color-gray-00);
      }
    }
  }

  .plants {
    $root: &;
    $size: 120px;

    $slugs: (pagePresentation, pageServices, pageProjects, pageContact);

    position: relative;
    max-height: $size;
    flex-grow: 1;
    margin-top: var(--space-24);
    display: flex;
    flex-direction: column;
    align-items: start;

    &__item {
      @include transition(opacity, medium);
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;

      #{$root}[data-active] & {
        opacity: 0;
      }

      @each $slug in $slugs {
        #{$root}[data-active='#{$slug}'] &[data-slug='#{$slug}'] {
          opacity: 1;
        }
      }
    }

    &__svg {
      height: 100%;
    }

    &--centre {
      display: none;
    }
  }

  @include until(desktop) {
    .sidebar {
      --plants-size: #{pxToRem(90px)};
      --plants-bottom: var(--space-48);
      --padding-bottom: var(--space-48);
      --content-gap: var(--space-48);
      --container-padding-y: var(--sidebar-padding-y);
      --container-padding-bottom: calc(
        var(--padding-bottom) + var(--plants-size) + var(--content-gap)
      );
      --main-rows: 1fr;
      --main-opacity: 1;

      position: sticky;
      bottom: initial;
      right: 0;
      top: 0;
      @include transition(transform, long);

      &:after {
        clip-path: polygon(0 0, 100% calc(100% - var(--sidebar-skew-size)), 100% 0, 0 100%);
        left: 0;
        right: 0;
        bottom: unset;
        top: 100%;
        width: auto;
        height: var(--sidebar-skew-size);
      }
    }

    .container {
      width: 100%;
      align-items: stretch;
      padding-right: var(--content-padding-x);
      padding-bottom: var(--container-padding-bottom);
      @include transition('padding', medium);
    }

    .content {
      align-items: center;
      gap: 0;
    }

    .main {
      align-items: flex-end;
      display: grid;
      grid-template-rows: var(--main-rows);
      @include transition('grid-template-rows, opacity', medium);
      vertical-align: bottom;
      opacity: var(--main-opacity);

      &__inner {
        flex-direction: column;
        display: flex;
        overflow: hidden;
        align-items: center;
        padding-top: var(--content-gap);
      }
    }

    .header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-self: stretch;
      align-items: start;

      a {
        display: flex;
      }
    }

    .menu {
      &__list {
        align-items: center;
      }
    }

    .plants {
      display: none;
      width: var(--plants-size);
      height: var(--plants-size);
      position: absolute;
      bottom: var(--plants-bottom);
      left: 50%;
      transform: translateX(-50%);
      margin-top: 24px;
      @include transition('width, height, bottom', medium);

      &--centre {
        display: block;
      }
    }

    .sidebar[data-open='false'] {
      --plants-size: #{pxToRem(30px)};
      --logo-height: var(--sidebar-logo-height-s);
      --container-padding-bottom: var(--container-padding-y);
      --plants-bottom: var(--container-padding-y);
      --main-rows: 0fr;
      --main-opacity: 0;

      &[data-slide-out='true'] {
        transform: translateY(calc(-100% - var(--sidebar-skew-size)));
      }
    }
  }
</style>
