---
import Logo from '@/assets/svgs/logo.svg'
import Separator from '@/components/Separator.astro'

import { getHerbier } from '@/lib/herbiers'
import type { PageSlug } from '@monolithe/api/types'

type Props = {
  home: {
    url: string
    linkLabel: string
  }
  menu: {
    title: string
    url: string
    slug: PageSlug
  }[]
  type?: 'big' | 'small'
  slug: PageSlug
  parentSlug?: PageSlug
}

const { home, menu, type = 'big', slug, parentSlug } = Astro.props

const herbier = getHerbier('left')
---

<aside
  class:list={['sidebar', `sidebar--${type}`]}
  data-sidebar={type}
  transition:animate="none"
  transition:persist="sidebar"
>
  <div class="container">
    <div class="content">
      <a href={home.url} aria-label={home.linkLabel}>
        <Logo class:list={'logo'} />
      </a>
      <Separator />
      <nav class="menu">
        <ul class="menu__list" data-menu>
          {
            menu.map(({ title, url, slug: itemSlug }) => (
              <li class="menu__item">
                <a
                  class:list={[
                    'menu__link',
                    (slug === itemSlug || parentSlug === itemSlug) && 'active',
                  ]}
                  href={url}
                  data-menu-item
                  data-slug={itemSlug}
                >
                  {title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <Separator />
    </div>
    <div class="plants" data-plants>
      {
        herbier.map(({ slug, plant }) => {
          const Plant = plant
          return (
            <div class="plants__item" data-slug={slug}>
              <Plant class:list={'plants__svg'} />
            </div>
          )
        })
      }
    </div>
  </div>
</aside>

<script>
  import { init as initMenu } from '@/lib/menu'

  const initSidebarState = () => {
    const body = document.querySelector('body')
    const slug = body?.dataset.slug
    const sidebar = body?.querySelector<HTMLElement>('[data-sidebar]')
    if (!slug || !sidebar) return
    // setTimeout(() => {
    sidebar.dataset.sidebar = slug === 'pageHome' ? 'big' : 'small'
    // }, 0)
  }

  const initMenuState = () => {
    const body = document.querySelector('body')
    const menuSlug = body?.dataset.menuSlug
    if (!menuSlug) return

    document.querySelectorAll<HTMLAnchorElement>('[data-menu-item]').forEach((item) => {
      item.dataset.slug === menuSlug
        ? item.classList.add('active')
        : item.classList.remove('active')
    })
  }

  document.addEventListener('astro:page-load', () => {
    initSidebarState()
    initMenuState()
  })

  initMenu('[data-plants]', '[data-menu-item]')
</script>

<style lang="scss">
  @use '../styles/utilities' as *;

  .sidebar {
    --container-width: var(--width-sidebar-big);
    --logo-width: #{pxToRem(180px)};
    --link-font-size: var(--font-size-xxl);
    --menu-gap: 0;

    &[data-sidebar='small'] {
      --container-width: var(--width-sidebar-small);
      --logo-width: #{pxToRem(90px)};
      --link-font-size: var(--font-size-xl);
      --menu-gap: var(--space-8);
    }

    view-transition-name: none;

    height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    position: fixed;
    z-index: 1;
    color: var(--color-gray-100);

    &:after {
      content: '';
      display: block;
      width: var(--width-sidebar-skew);
      background: var(--color-gold-40);
      clip-path: polygon(0 0, 100% 0, calc(100% - 80px) 100%, 0 100%);
      flex-shrink: 0;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 100%;
      z-index: 1;
    }
  }

  .container {
    background: var(--color-gold-40);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    padding: pxToRem(120px) 0 var(--space-80) var(--space-80);
    justify-content: space-between;
    width: var(--container-width);
    box-sizing: border-box;
    @include transition(width);

    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      right: 100%;
      bottom: 0;
      width: 100vw;
      background: var(--color-gold-40);
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: #{var(--space-48)};
  }

  .logo {
    width: var(--logo-width);
    @include transition(width);
  }

  .menu {
    font-family: var(--font-family-heading);

    &__list {
      display: flex;
      flex-direction: column;
      gap: var(--menu-gap);
      @include transition(gap);
    }

    &__link {
      font-family: var(--font-family-heading);
      font-size: var(--link-font-size);
      text-decoration: none;
      @include transition('color, font-size');

      &:hover,
      &.active {
        color: var(--color-gray-00);
      }
    }
  }

  .plants {
    $root: &;
    $size: 120px;

    $slugs: (pagePresentation, pageServices, pageProjects, pageContact);

    position: relative;
    max-height: $size;
    flex-grow: 1;
    margin-top: var(--space-24);
    display: flex;
    flex-direction: column;
    align-items: start;

    &__item {
      @include transition(opacity, medium);
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;

      #{$root}[data-active] & {
        opacity: 0;
      }

      @each $slug in $slugs {
        #{$root}[data-active='#{$slug}'] &[data-slug='#{$slug}'] {
          opacity: 1;
        }
      }
    }

    &__svg {
      height: 100%;
    }
  }
</style>
