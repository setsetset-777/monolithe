---
import Image from '@/components/Image.astro'
import type { Media } from '@monolithe/api/types'

interface Props {
  image?: Media
  isPlant?: boolean
}

const { image, isPlant } = Astro.props
---

<section class:list={['hero', isPlant && 'hero--plant']}>
  <div class="inner">
    <slot />
  </div>
  <div class="image">
    {
      image && (
        <Image
          src={image.url}
          alt={image.alt}
          srcset={{
            '800w': image.sizes?.[2000]?.url!,
            '1200w': image.sizes?.[3000]?.url!,
          }}
          modifiers={['fill']}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      )
    }
  </div>
</section>

<style lang="scss">
  @use '../styles/utilities' as *;

  .hero {
    --padding-top: var(--space-48);
    --padding-bottom: var(--space-80);
    position: relative;

    &--plant {
      // max-height: 75dvh;
    }
  }

  .inner {
    @include content-padding;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    position: relative;
    z-index: 1;
    display: flex;
  }

  .image {
    @include bleed;
    position: absolute;
    height: 100%;
    top: 0;
    overflow: hidden;

    & :global(img) {
      filter: grayscale(100%) blur(var(--blur));
    }

    &:after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      background-color: var(--color-gray-50);
      opacity: 0.8;
      z-index: 1;
    }
  }

  @include until(m, height) {
    .hero {
      &--plant {
        max-height: 75dvh;
      }
    }
  }

  @media (#{media(s, height, from)}) and (#{media(mobile, width, from)}) {
    .hero {
      --padding-top: var(--space-80);
      --padding-bottom: var(--space-128);
    }
  }
</style>
