---
import Image from '@/components/Image.astro'
import type { Media } from '@monolithe/api/types'

interface Props {
  image: Media
}

const { image } = Astro.props
---

<section class="hero">
  <div class="inner">
    <slot />
  </div>
  <div class="image">
    {
      image && (
        <Image
          src={image.url}
          alt={image.alt}
          srcset={{
            '800w': image.sizes?.[2000]?.url!,
            '1200w': image.sizes?.[3000]?.url!,
          }}
          modifiers={['fill']}
        />
      )
    }
  </div>
</section>

<style lang="scss">
  @use '../styles/utilities' as *;

  .hero {
    position: relative;
  }

  .inner {
    @include content-padding;
    padding-top: var(--space-80);
    padding-bottom: var(--space-128);
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  .image {
    @include bleed;
    position: absolute;
    height: 100%;
    top: 0;
    overflow: hidden;

    & :global(img) {
      filter: grayscale(100%) blur(var(--blur));
    }

    &:after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      background-color: var(--color-gray-50);
      opacity: 0.8;
      z-index: 1;
    }
  }
</style>
