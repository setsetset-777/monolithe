<div class="sidebar">
  <div class="sidebar__container">
    <div class="sidebar__content">
      <a href="<%- routes.pageHome.path %>" aria-label="<%- general.navigation.homeLinkLabel %>">
        <%- include('./svgs/logo', { class: "sidebar__logo"}) %>
      </a>
      <%- include('./separator') %>
      <nav class="sidebar-menu">
        <ul class="sidebar-menu__list">
          <% for (let {title, path, slug} of menu) {%>
            <li class="sidebar-menu__item">
              <a class="sidebar-menu__link" href="<%= path %>" data-slug="<%= slug %>">
                <%= title %>
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
      <%- include('./separator') %>
    </div>
    <div class="sidebar-plants">
      <% for (let [slug, svg] of Object.entries(plants.map)) {%>
        <div class="sidebar-plants__item" data-slug="<%= slug %>">
          <%- include(svg) %>
        </div>
      <% } %>
    </div>
  </div>
</div>
