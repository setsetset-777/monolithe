<footer class="footer">
  <div class="footer__container">
    <div class="footer__column">
      <div class="footer__header footer-logo">
        <%- include('svgs/logo') %>
        <h4 class=" footer-logo__catch">
          <%- generalData.footer.logoCatch %>
        </h4>
      </div>
      <div class="separator"></div>
      <div class="footer__contact footer-contact">
        <p class="footer-contact__text">
          <%- generalData.footer.contactText %>
        </p>
        <m-action class="footer-contact__action" href="<%- routes.pageContact.path %>">
          <%- generalData.footer.contactLabel %>
        </m-action>
        <!--<a class="footer-contact__action action" href="<%- routes.pageContact.path %>">
          <%- generalData.footer.contactLabel %>
        </a>-->
      </div>
    </div>
    <div class="footer__column">
      <div class="footer-services">
        <h4 class="footer-services__title">
          <%- routes.pageServices.title %>
        </h4>
        <ul>
          <% for (let {label} of generalData.services) { %>
            <li>
              <a href="<%- routes.pageServices.path %>#<%-encodeURIComponent(label) %>">
                <%- label %>
              </a>
            </li>
          <% } %>
        </ul>
      </div>
      <p class="footer-777 777">
        <span>Design & Code par</span>
        <%- include('svgs/777', { class: "menu__logo", width: "114" }) %>
      </p>
    </div>
  </div>
</footer>
