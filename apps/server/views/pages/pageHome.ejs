<div class="page page--home page-home">
  <section class="page-home-section page-home-section--hero page-home-hero">
    <div class="page-home-hero__image">
      <img
        src="<%= payloadUrl + pageData.presentation.heroImage.sizes['1000'].url %>"
        srcset="
          <%= payloadUrl + pageData.presentation.heroImage.sizes['2000'].url %> 800w,
          <%= payloadUrl + pageData.presentation.heroImage.sizes['3000'].url %> 1200w
        "
        sizes="100vw"
        alt="<%= pageData.presentation.heroImage.alt %>"
      >
    </div>
    <div class="page-home-section__inner">
      <div class="page-home-plants" aria-hidden>
        <div class="page-home-plants__inner">
          <% for(let i = 1; i <= 5; i++) { %>
            <%- include(`../partials/svgs/plants/herbier-centre-${i}.svg`) %>
          <% } %>
        </div>
      </div>
      <div class="page-home-hero__content">
        <h2 class="page-home-hero__catch"><%- pageData.presentation.catch %></h2>
        <%- include('../partials/separator') %>
        <%- include(`../partials/anchor`, {
          href: pageData.presentation.link,
          text: pageData.presentation.linkLabel,
        }) %>
      </div>
    </div>
    <div class="page-home-hero__footer">
      <button class="page-home-hero__down"§ aria-label="Défiler" data-scroll="#content">
        <%- include(`../partials/svgs/chevron-down`) %>
      </button>
    </div>
  </section>

  <div id="content" class="page-home__body">
    <section class="page-home__section page-home-section page-home-section--services">
      <div class="page-home-section__inner page-home-services">
        <div class="page-home-services__head">
          <h3 class="page-home-services__title"><%- pageData.services.title %></h3>
          <%- include(`../partials/anchor`, {
            href: pageData.services.link,
            text: pageData.services.linkLabel,
          }) %>
        </div>
        <ul class="page-home-services__list">
        <% for(let { title } of pageData.services.items) { %>
          <li class="page-home-services__item">
            <a href="#<%- encodeSlug(title) %>">
              <%= title %>
            </a>
          </li>
        <% } %>
        </ul>
      </div>
    </section>

    <div class="content-padding">
      <%- include(`../partials/separator`) %>
    </div>

    <section class="page-home__section page-home-section page-home-section--projects">
      <div class="page-home-section__inner page-home-projects">

        <div class="page-home-projects__slider page-home-slider" data-slider>
          <div class="page-home-slider__slides">
            <% for(let { project, image } of pageData.projects.highlightedProjects) { %>
              <div class="page-home-slider__slide" data-slider-item>
                <img
                  class="page-home-slider__img"
                  src="<%= payloadUrl + image.sizes['1000'].url %>"
                  srcset="
                    <%= payloadUrl + image.sizes['2000'].url %> 800w
                  "
                  sizes="100vw"
                  alt="<%= image.alt %>"
                  loading="lazy"
                >
                <a href="<%= project.url %>">
                  <h4 class="page-home-slider__title"><%= project.title %></h4>
                  <span class="page-home-slider__title"><%= pageData.projects.projectLinkLabel %></span>
                </a>
              </div>
            <% } %>
          </div>
          <div class="page-home-slider__remote" data-slider-remote>
            <% for(let i = 0; i < pageData.projects.highlightedProjects.length; i++) { %>
              <button class="page-home-slider__button" aria-label="Afficher l'image <% i - 1 %>"></button>
            <% } %>
          </div>
        </div>

        <%- include(`../partials/anchor`, {
          href: pageData.projects.link,
          text: pageData.projects.linkLabel,
        }) %>
      </div>
    </section>
  <div>
</div>
